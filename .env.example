# ---------------------------------------------------------------------------
# Frontend (Vite) — ces valeurs sont intégrées au bundle et donc PUBLIQUES.
# Ne jamais y mettre de clé secrète.
# ---------------------------------------------------------------------------

# URL de base de l'API HTTP (sortie CDK « ApiGatewayURL »).
# La barre finale est tolérée : elle est retirée côté client.
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# ---------------------------------------------------------------------------
# Backend (Lambda) — NE JAMAIS exposer côté frontend.
# En production, ces valeurs sont fournies au déploiement CDK via les secrets
# GitHub Actions, puis stockées dans AWS Secrets Manager
# (secret « limajs/backend/production »), que la Lambda lit à l'exécution.
# ---------------------------------------------------------------------------

# Clé API Resend (https://resend.com) — secret GitHub : RESEND_API_KEY
RESEND_API_KEY=

# Expéditeur des emails. Le domaine doit être vérifié dans Resend (limajs.com).
FROM_EMAIL=contact@limajs.com

# Destinataires du formulaire de contact, séparés par des virgules.
ADMIN_EMAILS=mainoffice@limajs.com

# Destinataire des notifications de déploiement.
DEV_MAIL=

# ---------------------------------------------------------------------------
# AWS DynamoDB / S3
# ---------------------------------------------------------------------------
TABLE_USERS=
TABLE_BUSES=
TABLE_ROUTES=
TABLE_SCHEDULES=
TABLE_SUBSCRIPTIONS=
TABLE_PAYMENTS=
TABLE_TICKETS=
TABLE_NFC_CARDS=
TABLE_TRIPS=
TABLE_GPS_POSITIONS=

AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
